[Unit]
Description=Trading bot forward test - BTC/USDT (Binance demo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingbot
WorkingDirectory=/opt/tradingbot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
# 小机器上别让 numpy 的 OpenBLAS 起一堆线程
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/tradingbot/.venv/bin/python main.py testnet --config config.portfolio.yaml --symbol BTC/USDT
Restart=always
RestartSec=30
# 软上限：超过后内核施压回收，不会杀进程。原来用 MemoryMax=450M 会在这个大
# 内存页的进程上反复触发回收/重启，2 GB 实例上没必要那么紧。
MemoryHigh=600M
StandardOutput=append:/var/log/tradingbot-btc.log
StandardError=append:/var/log/tradingbot-btc.log

[Install]
WantedBy=multi-user.target
